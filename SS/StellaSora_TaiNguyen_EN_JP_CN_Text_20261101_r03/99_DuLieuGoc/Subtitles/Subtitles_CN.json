{
  "locale": "CN",
  "files": [
    {
      "name": "CH04ED-CH04ED_CN.srt",
      "sha256": "6d6f0f681d0a908cfd26a4199eac210e1ddda9e4e67d82d5a09a0ead4cf186d8",
      "text": "﻿1\r\n00:00:00,725 --> 00:00:08,088\r\n被遗漏在某个角落的手持镜\r\n\r\n2\r\n00:00:08,728 --> 00:00:15,704\r\n已经看腻了的打发时间的电影\r\n\r\n3\r\n00:00:16,002 --> 00:00:23,704\r\n在寂静的大海中随着平稳的海浪摇晃\r\n\r\n4\r\n00:00:24,024 --> 00:00:31,384\r\n就这样一天一天飘荡 连天空都变得黯淡无光\r\n\r\n5\r\n00:00:31,704 --> 00:00:39,448\r\n想改变这压抑的未来 哪怕只有一点也好\r\n\r\n6\r\n00:00:39,768 --> 00:00:46,936\r\n以全新的姿态迈出第一步\r\n\r\n7\r\n00:00:47,501 --> 00:00:55,450\r\n心之所向是鲜明的世界\r\n\r\n8\r\n00:00:55,450 --> 00:01:02,963\r\n五线谱描绘出独属于自己的篇章\r\n\r\n9\r\n00:01:03,519 --> 00:01:11,519\r\n瞳中溢出的泪水并非因为悲伤\r\n\r\n10\r\n00:01:11,519 --> 00:01:20,287\r\n而是那星星的光辉过于耀眼\r\n\r\n"
    },
    {
      "name": "CH06ED-CH06ED_CN.srt",
      "sha256": "dd3301397fb78edf36ee39ec0364d60a4daaeb455d4bae1982b9ef1c5c14ad2a",
      "text": "﻿1\r\n00:00:16,125 --> 00:00:22,833\r\n回想起那遥远的过去 已褪色变得淡薄\r\n\r\n2\r\n00:00:22,958 --> 00:00:30,041\r\n融化的黑暗记忆 被指尖轻轻触碰\r\n\r\n3\r\n00:00:32,750 --> 00:00:40,000\r\n融入夜色悄然滑落的泪水\r\n\r\n4\r\n00:00:40,125 --> 00:00:42,041\r\n是指引未来的\r\n\r\n5\r\n00:00:42,166 --> 00:00:45,916\r\n唯一路标\r\n\r\n6\r\n00:00:46,125 --> 00:00:52,958\r\n描绘着光辉的轨迹\r\n\r\n7\r\n00:00:52,958 --> 00:00:58,833\r\n不会消失的思念 再次重叠\r\n\r\n8\r\n00:00:58,833 --> 00:01:00,958\r\n交织在一起\r\n\r\n9\r\n00:01:01,125 --> 00:01:16,625\r\n即使在黎明前迷失 也会一次又一次重新牵起彼此的手\r\n\r\n10\r\n00:01:17,875 --> 00:01:23,333\r\n宛如两颗不同的星辰 目眩神迷\r\n\r\n11\r\n00:01:23,333 --> 00:01:25,333\r\n沿着那轨迹\r\n\r\n12\r\n00:01:25,500 --> 00:01:29,250\r\n不断前行 直到抵达\r\n\r\n13\r\n00:01:29,375 --> 00:01:35,666\r\n你的身边\r\n"
    },
    {
      "name": "CH10001Intro1-CH10001Intro1_CNVA_FP_CN.srt",
      "sha256": "3c8f35e2bdfb1961b51e9d43f02239a3efea6e874f7f5475a288f35ecdfebe4a",
      "text": "﻿1\r\n00:00:42,580 --> 00:00:47,020\r\n魔王……\r\n\r\n2\r\n00:01:15,420 --> 00:01:18,500\r\n愿主公之身无灾无难\r\n\r\n3\r\n00:01:19,140 --> 00:01:20,330\r\n我没有指错\r\n\r\n4\r\n00:01:20,333 --> 00:01:22,208\r\n我一直在等待这一刻\r\n\r\n5\r\n00:01:23,666 --> 00:01:25,780\r\n而这把剑，也是为此准备的\r\n\r\n6\r\n00:01:25,780 --> 00:01:29,780\r\n这次，轮到我把你打得落花流水了\r\n\r\n7\r\n00:01:34,260 --> 00:01:36,580\r\n真的好想回到过去\r\n\r\n8\r\n00:01:36,580 --> 00:01:38,160\r\n重新开始……\r\n\r\n9\r\n00:01:39,130 --> 00:01:40,560\r\n向大家好好道歉……\r\n\r\n10\r\n00:01:40,560 --> 00:01:42,200\r\n然后回到她们身边\r\n\r\n11\r\n00:01:48,140 --> 00:01:48,540\r\n希望从此以后，你能一直一直在我身边\r\n\r\n12\r\n00:01:48,540 --> 00:01:49,780\r\n我一定……会在这里击败它！\r\n希望从此以后，你能一直一直在我身边\r\n\r\n13\r\n00:01:49,780 --> 00:01:51,600\r\n怎么说，要在这里跟我干一架吗？\r\n我一定……会在这里击败它！\r\n希望从此以后，你能一直一直在我身边\r\n\r\n14\r\n00:01:51,600 --> 00:01:52,479\r\n希望从此以后，你能一直一直在我身边\r\n怎么说，要在这里跟我干一架吗？\r\n\r\n15\r\n00:01:52,479 --> 00:01:52,860\r\n怎么说，要在这里跟我干一架吗？\r\n\r\n16\r\n00:01:55,833 --> 00:01:58,041\r\n万能的恩赐之神啊\r\n\r\n17\r\n00:01:58,040 --> 00:02:00,500\r\n我虔诚地向您许下愿望\r\n\r\n"
    },
    {
      "name": "CH10001Intro1-CH10001Intro1_JPVA_FP_CN.srt",
      "sha256": "5088fa2393d42692c0a503b6e58b950e3be476d8c6f3ceeb6e59f5f862409ff7",
      "text": "﻿1\r\n00:00:42,580 --> 00:00:47,020\r\n魔王……\r\n\r\n2\r\n00:01:15,437 --> 00:01:18,980\r\n愿主公之身无灾无难……\r\n\r\n3\r\n00:01:18,980 --> 00:01:21,229\r\n正是为了我相信的——\r\n\r\n4\r\n00:01:23,220 --> 00:01:26,060\r\n……那必定到来的此刻，所准备的东西\r\n\r\n5\r\n00:01:26,480 --> 00:01:29,580\r\n——轮到我把你打得落花流水了！\r\n\r\n6\r\n00:01:34,520 --> 00:01:36,580\r\n我想回到那个时候\r\n\r\n7\r\n00:01:36,580 --> 00:01:38,460\r\n为说过的那些过分的话好好道歉……\r\n\r\n8\r\n00:01:39,130 --> 00:01:41,720\r\n我想要回到大家的身边……\r\n\r\n9\r\n00:01:48,140 --> 00:01:48,729\r\n希望从此以后，你能一直一直在我身边\r\n\r\n10\r\n00:01:48,729 --> 00:01:49,622\r\n我一定……会在这里击败它！\r\n希望从此以后，你能一直一直在我身边\r\n\r\n11\r\n00:01:49,622 --> 00:01:51,897\r\n怎么说，要在这里跟我干一架吗？\r\n我一定……会在这里击败它！\r\n希望从此以后，你能一直一直在我身边\r\n\r\n12\r\n00:01:51,897 --> 00:01:53,371\r\n希望从此以后，你能一直一直在我身边\r\n怎么说，要在这里跟我干一架吗？\r\n\r\n13\r\n00:01:53,371 --> 00:01:53,577\r\n希望从此以后，你能一直一直在我身边\r\n\r\n14\r\n00:01:56,045 --> 00:01:58,228\r\n万能的恩赐之神啊\r\n\r\n15\r\n00:01:58,537 --> 00:02:01,229\r\n我虔诚地向您许下愿望\r\n\r\n"
    },
    {
      "name": "CH10001Intro2-CH10001Intro2_CNVA_FP_CN.srt",
      "sha256": "ace17ce3789922239faabe9cb1149bfeb81fb2a15741fc60614c12deede35759",
      "text": "﻿1\r\n00:00:03,130 --> 00:00:04,600\r\n喂……醒醒……\r\n\r\n2\r\n00:00:04,880 --> 00:00:06,780\r\n快醒醒啊……喂——\r\n\r\n3\r\n00:00:09,160 --> 00:00:11,480\r\n哈……你终于醒了！\r\n\r\n4\r\n00:00:16,280 --> 00:00:17,260\r\n她醒过来了？\r\n\r\n"
    },
    {
      "name": "CH10001Intro2-CH10001Intro2_CNVA_MP_CN.srt",
      "sha256": "69188b761e81355a71698dd855d76d4ad6cb4fa34efb638176ad26e8e5beee55",
      "text": "﻿1\r\n00:00:03,130 --> 00:00:04,600\r\n喂……醒醒……\r\n\r\n2\r\n00:00:04,880 --> 00:00:06,780\r\n快醒醒啊……喂——\r\n\r\n3\r\n00:00:09,160 --> 00:00:11,480\r\n哈……你终于醒了！\r\n\r\n4\r\n00:00:16,280 --> 00:00:17,260\r\n他醒过来了？\r\n\r\n"
    },
    {
      "name": "CH10001Intro2-CH10001Intro2_JPVA_FP_CN.srt",
      "sha256": "64926e1ea33502d9f5fcdbbe82cabe47251e76b8a09ace98e27d952398cdb62d",
      "text": "﻿1\r\n00:00:03,150 --> 00:00:05,610\r\n那个……那个——！\r\n\r\n2\r\n00:00:05,750 --> 00:00:07,360\r\n请您快醒过来吧，醒醒呀！\r\n\r\n3\r\n00:00:09,150 --> 00:00:11,780\r\n哈……您终于醒了！\r\n\r\n4\r\n00:00:14,670 --> 00:00:17,620\r\n看来你的伙伴总算醒了呢\r\n\r\n"
    },
    {
      "name": "Prologue-Prologue_P4_CNVA_FP_CN.srt",
      "sha256": "886886f6b9c8f83e8020fd9c39675df39c40a5577048f84fbf8b426e87678ff8",
      "text": "﻿1\r\n00:00:02,852 --> 00:00:07,140\r\n诺瓦人常说 不要踏入荒野\r\n\r\n2\r\n00:00:08,775 --> 00:00:13,300\r\n他们固守着城邦 畏惧着外面的一切\r\n\r\n3\r\n00:00:14,088 --> 00:00:19,016\r\n而旅人会说 不要温和地踏入那片荒野\r\n\r\n4\r\n00:00:20,574 --> 00:00:22,750\r\n她们走出城墙\r\n\r\n5\r\n00:00:24,496 --> 00:00:26,462\r\n她们攀登星塔\r\n\r\n6\r\n00:00:29,343 --> 00:00:31,511\r\n她们寻找神器\r\n\r\n7\r\n00:00:32,959 --> 00:00:36,442\r\n她们为城邦带来文明\r\n\r\n8\r\n00:00:38,207 --> 00:00:41,538\r\n她们被城邦视为异类\r\n\r\n9\r\n00:00:42,832 --> 00:00:46,868\r\n但 她们并不在乎\r\n\r\n10\r\n00:00:48,228 --> 00:00:50,623\r\n因为旅人不属于城邦\r\n\r\n11\r\n00:00:52,312 --> 00:00:55,187\r\n旅人\r\n\r\n12\r\n00:00:55,187 --> 00:00:57,176\r\n只属于自己\r\n\r\n13\r\n00:01:00,051 --> 00:01:03,432\r\n没人记得第一位旅人的名字\r\n\r\n14\r\n00:01:05,756 --> 00:01:07,851\r\n繁荣承平的时代\r\n\r\n15\r\n00:01:07,851 --> 00:01:10,940\r\n把历史涂抹成另外的模样\r\n\r\n16\r\n00:01:13,212 --> 00:01:14,925\r\n然而\r\n\r\n17\r\n00:01:14,925 --> 00:01:18,140\r\n当命定的王座被旅人开启\r\n\r\n18\r\n00:01:20,829 --> 00:01:23,215\r\n变革\r\n\r\n19\r\n00:01:23,215 --> 00:01:27,434\r\n已经悄然来到每个人的门前\r\n\r\n"
    },
    {
      "name": "Prologue-Prologue_P4_JPVA_FP_CN.srt",
      "sha256": "0377d398943b0ff3971bf9e2945f9a8f5af2e082310c950daf803de0117ce5ca",
      "text": "﻿1\r\n00:00:02,796 --> 00:00:07,500\r\n诺瓦人常说 不要踏入荒野\r\n\r\n2\r\n00:00:08,704 --> 00:00:13,632\r\n他们固守着城邦 畏惧着外面的一切\r\n\r\n3\r\n00:00:14,242 --> 00:00:19,712\r\n而旅人会说 不要温和地踏入那片荒野\r\n\r\n4\r\n00:00:20,736 --> 00:00:23,360\r\n她们走出城墙\r\n\r\n5\r\n00:00:25,076 --> 00:00:27,264\r\n她们攀登星塔\r\n\r\n6\r\n00:00:29,426 --> 00:00:31,532\r\n她们寻找神器\r\n\r\n7\r\n00:00:32,746 --> 00:00:35,693\r\n她们为城邦带来文明\r\n\r\n8\r\n00:00:37,888 --> 00:00:42,432\r\n她们被城邦视为异类\r\n\r\n9\r\n00:00:43,587 --> 00:00:47,714\r\n但 她们并不在乎\r\n\r\n10\r\n00:00:47,714 --> 00:00:49,691\r\n因为旅人不属于城邦\r\n\r\n11\r\n00:00:51,008 --> 00:00:55,077\r\n旅人\r\n\r\n12\r\n00:00:55,077 --> 00:00:57,216\r\n只属于自己\r\n\r\n13\r\n00:01:00,263 --> 00:01:03,614\r\n没人记得第一位旅人的名字\r\n\r\n14\r\n00:01:03,614 --> 00:01:06,816\r\n繁荣承平的时代\r\n\r\n15\r\n00:01:06,816 --> 00:01:11,040\r\n把历史涂抹成另外的模样\r\n\r\n16\r\n00:01:12,960 --> 00:01:14,749\r\n然而\r\n\r\n17\r\n00:01:14,749 --> 00:01:18,310\r\n当命定的王座被旅人开启\r\n\r\n18\r\n00:01:21,029 --> 00:01:23,984\r\n变革\r\n\r\n19\r\n00:01:23,984 --> 00:01:27,337\r\n已经悄然来到每个人的门前\r\n\r\n"
    }
  ]
}
